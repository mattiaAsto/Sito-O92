# Python runtime (Render reads PYTHON_VERSION; must be a full version)
PYTHON_VERSION=3.11.9

SECRET_KEY=replace-with-a-random-secret
DB_COMPLETE_URL=sqlite:///app.db

APP_ENV=development

MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=60

DROPBOX_API_KEY=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
